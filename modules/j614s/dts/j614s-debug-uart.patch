From: nix-config
Subject: [PATCH] arm64: dts: apple: j614s: debug UART on DockChannel channel 1

---
--- a/arch/arm64/boot/dts/apple/t6040-j614s.dts	1970-01-01 05:30:01.000000000 +0530
+++ b/arch/arm64/boot/dts/apple/t6040-j614s.dts	2026-11-15 02:16:55.137084306 +0530
@@ -216,3 +216,32 @@
 };
 
 #include "t6040-j614s-extdisp-hdmi.dtsi"
+
+/*
+ * The debug UART: DockChannel channel 1, which a host reads over debug USB
+ * (macvdmtool debugusb, kis channel 1) and where aura logs. From the ADT
+ * (/arm-io/dockchannel-uart: block 0x508828000, IRQ registers 0x50880c000,
+ * interrupt 360); channel n has its config window at 0xc000 * n and data
+ * 0x4000 above it. As serial0 and stdout-path it is U-Boot's console and
+ * Linux's earlycon and ttyDC0.
+ */
+/ {
+	aliases {
+		serial0 = &dockchannel_uart;
+	};
+
+	chosen {
+		stdout-path = "serial0";
+	};
+
+	dockchannel_uart: serial@508838000 {
+		compatible = "apple,dockchannel-uart";
+		reg = <0x5 0x08838000 0x0 0x4000>,
+		      <0x5 0x08834000 0x0 0x4000>,
+		      <0x5 0x0880c000 0x0 0x18>;
+		reg-names = "data", "config", "irq";
+		apple,channel = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 360 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
