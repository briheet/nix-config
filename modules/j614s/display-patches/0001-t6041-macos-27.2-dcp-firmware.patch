drm/apple: T6041 (M4 Pro) internal panel on the macOS 27.2 DCP firmware

The T6041 DCP was driven only on 26.5.2/26.6.2 firmware (desktop IOMFB).
On 27.2 drive it through the firmware-27 interface written for the T6050
(DCP_FIRMWARE_V_27_0), as T8142 is on 27.0: aura publishes
firmware-version 27.2.x with firmware-compat 27.0.0 (aura-patches/0002).
On that path, like the T6050: adopt the running session and open no DPTX
port services on the panel processor; no firmware clock ids (the T6041
device tree names none); the desktop shared-memory mapping (buffers in
linear-mapped RAM, which memremap(WC) refuses); and log the coprocessor
handoff state. 27.2 numbers its methods A400-A499 50 higher than 27.0 (start_signal
A401 is A451) and
A389/A390 one higher (the first run crashed the firmware with "callback not
found: A427", 27.0's get_color_remap_mode, 27.2's A477): outgoing tags
are renumbered at push time; the 27.0 table stays as it is for the T6050.
Without apple,max-brightness the panel gets the desktop 600-nit SDR ceiling,
as on 26.x: with none, no swap was submitted (logged as "swap failed!
status -1", now named as such).
appledrm.t6041_fw27=0 leaves the panel on the boot framebuffer (nix-config
specialisation simpledrm).
(github:briheet/nixos-m4pro docs/display/dcp-27.2-kernel.md, dcp-27.2-rpc.md)
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -465,6 +465,12 @@
 
 	/* firmware version and compatible firmware version */
 	enum dcp_firmware_version fw_compat;
+	/*
+	 * macOS 27.2 firmware on the firmware-27 interface (T6041, j614s): its
+	 * methods A400-A499 are numbered 50 higher than 27.0's, and A389/A390
+	 * one higher (see dcp_retag_v27_2()).
+	 */
+	bool fw_v27_2;
 	/* Bumped by every iomfb poweron; see afk_compact_slot(). */
 	u32 afk_power_gen;
 	bool external;
@@ -1208,4 +1214,29 @@
 
 void dcp_panel_edid_receive(struct apple_dcp *dcp, const void *blob, size_t len);
 
+
+/*
+ * The 27.2 number of a 27.0 method tag (nixos-m4pro docs/display/dcp-27.2-rpc.md):
+ * A400-A499 move up by 50, A389/A390 by one. The
+ * callbacks the firmware calls (D###) keep their numbers.
+ */
+static inline void dcp_retag_v27_2(char tag[4])
+{
+	unsigned int n;
+
+	if (tag[0] != 'A' || tag[1] < '0' || tag[1] > '9' || tag[2] < '0' ||
+	    tag[2] > '9' || tag[3] < '0' || tag[3] > '9')
+		return;
+	n = (tag[1] - '0') * 100 + (tag[2] - '0') * 10 + (tag[3] - '0');
+	if (n >= 400 && n <= 499)	/* start_signal A401 -> A451 included */
+		n += 50;
+	else if (n == 389 || n == 390)
+		n += 1;
+	else
+		return;
+	tag[1] = '0' + n / 100;
+	tag[2] = '0' + n / 10 % 10;
+	tag[3] = '0' + n % 10;
+}
+
 #endif /* __APPLE_DCP_INTERNAL_H__ */
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -381,6 +381,32 @@
 		 "T6041: drive the external display processors (default 1; 0 leaves them alone)");
 
 /*
+ * T6041 internal panel on the macOS 27.2 DCP firmware (j614s): the boot loader
+ * (aura with nix-config's aura-patches) publishes firmware-version 27.2.x with
+ * firmware-compat 27.0.0, and it is driven through the T6050's firmware-27
+ * interface, as T8142 is on 27.0. t6041_fw27=0 leaves the panel on the boot
+ * framebuffer instead.
+ */
+static bool t6041_fw27 = true;
+module_param(t6041_fw27, bool, 0444);
+MODULE_PARM_DESC(t6041_fw27,
+		 "T6041 internal panel: drive the 27.2 DCP firmware through the firmware-27 interface (default 1)");
+
+static bool dcp_t6041_fw27(struct device *dev)
+{
+	u32 compat[3], version[3];
+
+	return t6041_fw27 &&
+	       of_device_is_compatible(dev->of_node, "apple,t6041-dcp") &&
+	       of_property_count_u32_elems(dev->of_node, "apple,firmware-compat") == 3 &&
+	       !of_property_read_u32_array(dev->of_node, "apple,firmware-compat", compat, 3) &&
+	       compat[0] == 27 && compat[1] == 0 && compat[2] == 0 &&
+	       of_property_count_u32_elems(dev->of_node, "apple,firmware-version") == 3 &&
+	       !of_property_read_u32_array(dev->of_node, "apple,firmware-version", version, 3) &&
+	       version[0] == 27 && version[1] == 2;
+}
+
+/*
  * After a wake that finds the internal panel off by DPMS, start its firmware from the
  * resume, as macOS does about 83 ms into a wake, so that DPMS on only has to light the
  * panel. If DPMS on hasn't come this long after, the firmware stops again. 0: the
