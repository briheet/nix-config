The 27.2 submission path (diff items 7, 11, 15, 16; §17, §18):
- device control: scheduler-state release as 0x13 (27.2's 0x14 stores through
  the record), the 27.2 power-assert rule (0x08, 0x09, 0x0a, 0x29), and the
  live Region C fields (effort, override, tally) 4 bytes later;
- Region C in the 27.2 layout (+4 from 0x34; unk_78 = 1, 2, 902);
- render queues: 0x80-byte (M5) queue records, item rings of [lead],
  configuration and a tag-16 notification with the current timestamp (no
  descriptor; a configuration with every kick), kick entries holding
  event 254 until the notification. Compute is not converted yet.

--- a/drivers/gpu/drm/asahi/g17/fw/initdata/v27_2.rs
+++ b/drivers/gpu/drm/asahi/g17/fw/initdata/v27_2.rs
@@ -275,3 +275,26 @@
 ];
 /// Where the 27.2 power state holds the maximum power in mW.
 pub(crate) const POWER_STATE_MAX_POWER: usize = 0x12c;
+
+/// Size of Region C as the driver builds it.
+pub(crate) const REGION_C: usize = 0x1000;
+/// 27.2 has one more u32 at +0x34 (or +0x38: both give the same bytes); everything from 25G83's
+/// +0x34 on, the live effort, override and power-assert tally included, sits 4 bytes later.
+pub(crate) const REGION_C_SHIFT: usize = 4;
+
+/// Moves the 25G83 Region C in `block` to the 27.2 layout, with macOS 27.2's values.
+pub(crate) fn region_c(block: &mut [u8]) -> Result {
+    if block.len() != REGION_C {
+        return Err(EINVAL);
+    }
+    relayout(
+        block,
+        &[run(0, 0x34, 0), run(0x34, REGION_C - REGION_C_SHIFT, 0x34 + REGION_C_SHIFT)],
+    )?;
+    put(block, 0x34, &1u32.to_le_bytes())?;
+    // 25G83 unk_78 (T6040: 1, 0, 0).
+    for (i, value) in [1u32, 2, 902].into_iter().enumerate() {
+        put(block, 0x7c + 4 * i, &value.to_le_bytes())?;
+    }
+    Ok(())
+}
