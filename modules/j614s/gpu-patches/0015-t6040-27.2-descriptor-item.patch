27.2 with firmware-installed queues: keep the descriptor item in the ring
(driver-27.2-diff.md §18.4). With hardware data +0x2730 = 0 the firmware
links a pass's job when it dispatches the descriptor command; without it the
work ran but completion had no job to retire (no stamps, no events).

--- a/drivers/gpu/drm/asahi/g17/fw/variant.rs
+++ b/drivers/gpu/drm/asahi/g17/fw/variant.rs
@@ -100,9 +100,9 @@
     /// [`super::initdata::v27_2`]).
     pub(crate) data_27_2: bool,
     /// The 27.2 render submission (j614s patch; nixos-m4pro docs/gpu/driver-27.2-diff.md §18):
-    /// 0x80-byte queue records (the M5 layout) and item rings of [lead], configuration (with
-    /// every kick) and the tag-14 announcement, without a descriptor item. The queues are
-    /// installed by the firmware (hardware data +0x2730 = 0).
+    /// 0x80-byte queue records (the M5 layout) and a configuration with every kick; the item
+    /// rings keep the 25G83 order ([lead], descriptor, configuration, tag-14 announcement). The
+    /// queues are installed by the firmware (hardware data +0x2730 = 0).
     pub(crate) kick_notification: bool,
 }
 
--- a/drivers/gpu/drm/asahi/g17/queue/render/publication.rs
+++ b/drivers/gpu/drm/asahi/g17/queue/render/publication.rs
@@ -67,9 +67,10 @@
         // records, never the M5 Pro's descriptor-less tag-16 notification.
         let j813 = crate::g17::J813_FORMS.load(core::sync::atomic::Ordering::Relaxed);
         let m5 = graph.is_m5() && !j813;
-        // 27.2 with firmware-installed queues: no descriptor item (the kick entry names it), and
-        // the tag-14 announcement, which advances the queue's kick count in the KSM.
-        let bare = m5 || graph.notifies();
+        // 27.2 with firmware-installed queues (hardware data +0x2730 = 0) keeps the 25G83 items:
+        // the firmware links the pass's job when it dispatches the descriptor item, and
+        // completion retires it (driver-27.2-diff.md §18.4).
+        let bare = m5;
         // M5 items carry no descriptor: [configuration], notification.
         let count = u32::from(present) + u32::from(lead) + if bare { 1 } else { 2 };
         let window = Window::new(base, count, ITEM_RING_ENTRIES)?;
