+
+/// j614s bring-up: the firmware log is enabled (main configuration +0x250) and its messages are
+/// printed when a render times out.
+pub(crate) const FW_LOG_ENABLE: bool = true;
+/// The log messages in status A: 9 rings of 256 messages of 0xd8 bytes.
+pub(crate) const FW_LOG_MESSAGES: usize = 0x2d2c0;
+pub(crate) const FW_LOG_BYTES: usize = 9 * 256 * FW_LOG_MESSAGE;
+const FW_LOG_MESSAGE: usize = 0xd8;
+static FW_LOG: core::sync::atomic::AtomicPtr<u8> =
+    core::sync::atomic::AtomicPtr::new(core::ptr::null_mut());
+
+/// Remembers where the firmware writes its log messages (`FW_LOG_BYTES` at `messages`, a
+/// kernel mapping that lives as long as the device).
+pub(crate) fn set_fw_log(messages: *mut u8) {
+    FW_LOG.store(messages, core::sync::atomic::Ordering::Release);
+}
+
+/// Prints the firmware's log messages (bring-up).
+pub(crate) fn dump_fw_log() {
+    let base = FW_LOG.load(core::sync::atomic::Ordering::Acquire);
+    if base.is_null() {
+        return;
+    }
+    let mut printed = 0;
+    for index in 0..FW_LOG_BYTES / FW_LOG_MESSAGE {
+        // SAFETY: set_fw_log() named FW_LOG_BYTES of a live mapping; the firmware may be writing
+        // a message while it is copied, which only garbles that message.
+        let mut message = [0u8; FW_LOG_MESSAGE];
+        unsafe {
+            core::ptr::copy_nonoverlapping(base.add(index * FW_LOG_MESSAGE), message.as_mut_ptr(), FW_LOG_MESSAGE)
+        };
+        if message.iter().all(|&b| b == 0) {
+            continue;
+        }
+        let mut text = [b' '; FW_LOG_MESSAGE - 0x10];
+        let mut len = 0;
+        for &b in &message[0x10..] {
+            if b == 0 {
+                break;
+            }
+            text[len] = if (0x20..0x7f).contains(&b) { b } else { b'.' };
+            len += 1;
+        }
+        let text = core::str::from_utf8(&text[..len]).unwrap_or("?");
+        pr_warn!(
+            "j614s-fwlog {:4} {} {}\n",
+            index,
+            crate::fwid::Hex(&message[..0x10]),
+            text
+        );
+        printed += 1;
+        if printed >= 400 {
+            break;
+        }
+    }
+    pr_warn!("j614s-fwlog: {} messages\n", printed);
+}
