+/// the firmware-control pointers confirmed in macOS 27.2's status B at its InitData message).
+pub(crate) const STATUS_B_SHIFT: usize = 0x1e0;
+/// The status B word macOS 27.2 sets to 1 at start.
+pub(crate) const STATUS_B_E714: usize = 0xe714;
