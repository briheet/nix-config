 /// The status B word macOS 27.2 sets to 1 at start.
 pub(crate) const STATUS_B_E714: usize = 0xe714;
+
+/// Region C's host idle timestamp pair in 27.2 (u64 system counter, u64 period in its clocks).
+pub(crate) const REGION_C_IDLE_TIMESTAMP: usize = 0x98c;
+
+static EVENTS_LOGGED: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+
+/// Logs a firmware event's words (bring-up; the first 40).
+pub(crate) fn log_event(words: &[u32]) {
+    if !bringup() || EVENTS_LOGGED.fetch_add(1, core::sync::atomic::Ordering::Relaxed) >= 40 {
+        return;
+    }
+    let mut bytes = [0u8; 72];
+    for (i, w) in words.iter().take(18).enumerate() {
+        bytes[i * 4..i * 4 + 4].copy_from_slice(&w.to_le_bytes());
+    }
+    pr_warn!("j614s-event type {:#x} {}\n", words.first().copied().unwrap_or(0), crate::fwid::Hex(&bytes));
+}
