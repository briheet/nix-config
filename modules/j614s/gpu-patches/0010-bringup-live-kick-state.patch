+    /// j614s bring-up: the live kick entries, queue records and pointer blocks of this pair.
+    fn dump_live_state(&self) {
+        use crate::g17::fw::initdata::v27_2 as d;
+        if !d::bringup() {
+            return;
+        }
+        let qids = self.qids();
+        for stage in 0..2 {
+            let qid = u32::from(qids[stage]);
+            let last = self.kicks[stage].timestamp().prev();
+            if let Some(entry) = self.kicks[stage].peek_entry(last) {
+                d::dump_live("kick", qid, entry, 0x200);
+            }
+            let graph = &self.memory.graph;
+            if let Ok(record) = graph.queues.pointer(graph.queue_offset(qids[stage]), 0x80) {
+                d::dump_live("record", qid, record, 0x80);
+            }
+            if let Ok(pointers) = graph.queues.pointer(memory::POINTERS[stage], 0x80) {
+                d::dump_live("pointers", qid, pointers, 0x80);
+            }
+        }
     }
 
