+
+/// Logs `bytes` (`len` from `base`) in nonzero 32-byte rows, unlimited (bring-up).
+pub(crate) fn dump_live(tag: &str, qid: u32, base: *const u8, len: usize) {
+    if !bringup() || base.is_null() {
+        return;
+    }
+    let mut row = [0u8; 32];
+    for offset in (0..len).step_by(32) {
+        let n = core::cmp::min(32, len - offset);
+        // SAFETY: the caller names a live mapping of `len` bytes.
+        unsafe { core::ptr::copy_nonoverlapping(base.add(offset), row.as_mut_ptr(), n) };
+        if row[..n].iter().all(|&b| b == 0) {
+            continue;
+        }
+        pr_warn!("j614s-live {} q{} +{:03x} {}\n", tag, qid, offset, crate::fwid::Hex(&row[..n]));
+    }
+}
