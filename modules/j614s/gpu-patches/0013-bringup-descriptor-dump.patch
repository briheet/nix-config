j614s bring-up: on a render timeout also log the TA and 3D descriptors with
their register arrays ("ta-desc", "3d-desc").

--- a/drivers/gpu/drm/asahi/g17/queue/render.rs
+++ b/drivers/gpu/drm/asahi/g17/queue/render.rs
@@ -1675,6 +1675,15 @@
             if let Ok(pointers) = graph.queues.pointer(memory::POINTERS[stage], 0x80) {
                 d::dump_live("pointers", qid, pointers, 0x80);
             }
+            // The work descriptor with its register arrays (the register program).
+            if let Some(front) = self.active.front() {
+                let size = if stage == 0 { abi::TA_DESCRIPTOR_SIZE } else { abi::FRAGMENT_SLOT_SIZE };
+                if let Ok(descriptor) =
+                    graph.descriptors.pointer(graph.offset(stage, front.ticket.ordinal), size)
+                {
+                    d::dump_live(if stage == 0 { "ta-desc" } else { "3d-desc" }, qid, descriptor, size);
+                }
+            }
         }
     }
 
