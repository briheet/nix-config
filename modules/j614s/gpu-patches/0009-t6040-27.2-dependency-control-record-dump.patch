+
+/// Bits 63:48 of a kick entry's dependency control: 0xffff (25G83), 0x0fa0 under macOS 27.2.
+static KICK_DEPENDENCY_HIGH: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0xffff);
+
+/// Selects the 27.2 kick-entry dependency control (one GPU per system).
+pub(crate) fn set_kick_dependency_high(value: u16) {
+    KICK_DEPENDENCY_HIGH.store(value.into(), core::sync::atomic::Ordering::Relaxed);
+}
+
+/// Bits 63:48 of the dependency control word, in place.
+pub(crate) fn kick_dependency_high() -> u64 {
+    u64::from(KICK_DEPENDENCY_HIGH.load(core::sync::atomic::Ordering::Relaxed)) << 48
+}
+
+/// Whether the j614s bring-up logging is active.
+pub(crate) fn bringup() -> bool {
+    !FW_LOG.load(core::sync::atomic::Ordering::Acquire).is_null()
+}
+
+static RECORDS_DUMPED: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+
+/// Logs a submission record's nonzero 32-byte rows (bring-up; the first few records only).
+pub(crate) fn dump_record(tag: &str, qid: u32, bytes: &[u8]) {
+    if !bringup() || RECORDS_DUMPED.fetch_add(1, core::sync::atomic::Ordering::Relaxed) >= 40 {
+        return;
+    }
+    for (row, chunk) in bytes.chunks(32).enumerate() {
+        if chunk.iter().all(|&b| b == 0) {
+            continue;
+        }
+        pr_warn!("j614s-rec {} q{} +{:03x} {}\n", tag, qid, row * 32, crate::fwid::Hex(chunk));
+    }
+}
