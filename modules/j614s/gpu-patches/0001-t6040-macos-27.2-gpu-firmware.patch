+/// The offset of `size` bytes at `iova` inside `len` bytes at `start`, if they lie inside.
+fn offset_in(start: u64, len: u64, iova: usize, size: usize) -> Option<usize> {
+    let offset = (iova as u64).checked_sub(start)?;
+    (offset.checked_add(size as u64)? <= len).then_some(offset as usize)
+}
+
+/// A memory resource for `len` bytes at physical `start`.
+fn memory_resource(start: u64, len: u64) -> Result<io::resource::Resource> {
+    if len == 0 {
+        return Err(EINVAL);
+    }
+    // SAFETY: All-zero is a valid `struct resource` (no name, parent or children).
+    let mut raw: kernel::bindings::resource = unsafe { core::mem::zeroed() };
+    raw.start = start;
+    raw.end = start.checked_add(len - 1).ok_or(EINVAL)?;
+    raw.flags = kernel::bindings::IORESOURCE_MEM as usize;
+    // SAFETY: `Resource` is a transparent wrapper around `Opaque<bindings::resource>`, and `raw`
+    // describes a valid memory range (as `Uat::map_physical` builds it).
+    Ok(unsafe { core::mem::transmute(kernel::types::Opaque::new(raw)) })
+}
