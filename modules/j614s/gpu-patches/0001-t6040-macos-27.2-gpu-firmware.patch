+/// 27.2 (j614s patch): the firmware copies the host's idle timestamp pair (Region C +0x98c:
+/// the system counter, then the power period in its clocks) when it drains this record; the
+/// record has no fields. macOS 27.2 sends it before its first kick and through its life.
+#[repr(C)]
+#[derive(Debug)]
+pub(crate) struct IdleTimestamp {
+    pub(crate) opcode: u32,
+    pub(crate) unk_04: [u8; 0x3c],
+}
+
+static_assert!(size_of::<IdleTimestamp>() == DEVICE_CONTROL_RECORD_SIZE);
+
+impl IdleTimestamp {
+    pub(crate) const fn new() -> Self {
+        Self { opcode: DeviceControlOp::IdleTimestamp as u32, unk_04: [0; 0x3c] }
+    }
+}
