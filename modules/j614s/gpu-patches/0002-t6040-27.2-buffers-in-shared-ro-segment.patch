Map the 27.2 firmware's buffer requests in its third segment: the 27.2
firmware asks for its RTKit buffers (crash log) in __DATA_SHARED_RO, which
aura publishes as apple,fw-data-shared-ro; the driver refused them (-22).

--- a/drivers/gpu/drm/asahi/g17/data_segment.rs
+++ b/drivers/gpu/drm/asahi/g17/data_segment.rs
@@ -11,6 +11,10 @@
 //! A firmware that places its own crash log ([`super::CrashBuffers::FirmwareData`]) asks for it
 //! by physical address inside its data segment, the `fw-data` reserved region, which the boot
 //! loader keeps for the loaded firmware until reboot.
+//!
+//! The macOS 27.2 firmware of the M4 Pro (j614s patch) has a third segment, `__DATA_SHARED_RO`,
+//! in its own region (the ADT's `gfx-data-shared-ro`), and asks for its buffers there. aura
+//! reserves it and publishes it as `apple,fw-data-shared-ro` (base, size).
 
 use kernel::{
     c_str, device,
@@ -31,14 +35,23 @@
 
 impl DataSegmentLog {
     /// Maps the `size` bytes at physical address `iova` that the firmware asked for, which
-    /// must lie inside the `fw-data` region of `dev`.
+    /// must lie inside the `fw-data` region of `dev`, or inside `apple,fw-data-shared-ro`.
     pub(super) fn map(dev: &device::Device, iova: usize, size: usize) -> Result<Self> {
         let node = dev.of_node().ok_or(EINVAL)?;
         let res = node.reserved_mem_region_to_resource_byname(c_str!("fw-data"))?;
-        let offset = iova.checked_sub(res.start().try_into()?).ok_or(EINVAL)?;
-        if offset.checked_add(size).ok_or(EINVAL)? > res.size().try_into()? {
-            return Err(EINVAL);
-        }
+        let (res, offset) = match offset_in(res.start() as u64, res.size() as u64, iova, size) {
+            Some(offset) => (res, offset),
+            None => {
+                let cells = node
+                    .get_property::<KVec<u32>>(c_str!("apple,fw-data-shared-ro"))
+                    .map_err(|_| EINVAL)?;
+                let [b_hi, b_lo, s_hi, s_lo] = cells.as_slice().try_into().map_err(|_| EINVAL)?;
+                let start = (u64::from(b_hi) << 32) | u64::from(b_lo);
+                let len = (u64::from(s_hi) << 32) | u64::from(s_lo);
+                let offset = offset_in(start, len, iova, size).ok_or(EINVAL)?;
+                (memory_resource(start, len)?, offset)
+            }
+        };
         // SAFETY: The boot loader reserved this RAM for the loaded GPU firmware, which keeps
         // it until reboot; only the requested subrange is exposed.
         let mem = unsafe { io::mem::Mem::try_new(res, io::mem::MemFlag::WB.into())? };
@@ -54,3 +67,24 @@
         Ok(IoSysMap::Sys(unsafe { io::SysMem::new(ptr) }))
     }
 }
+
+/// The offset of `size` bytes at `iova` inside `len` bytes at `start`, if they lie inside.
+fn offset_in(start: u64, len: u64, iova: usize, size: usize) -> Option<usize> {
+    let offset = (iova as u64).checked_sub(start)?;
+    (offset.checked_add(size as u64)? <= len).then_some(offset as usize)
+}
+
+/// A memory resource for `len` bytes at physical `start`.
+fn memory_resource(start: u64, len: u64) -> Result<io::resource::Resource> {
+    if len == 0 {
+        return Err(EINVAL);
+    }
+    // SAFETY: All-zero is a valid `struct resource` (no name, parent or children).
+    let mut raw: kernel::bindings::resource = unsafe { core::mem::zeroed() };
+    raw.start = start;
+    raw.end = start.checked_add(len - 1).ok_or(EINVAL)?;
+    raw.flags = kernel::bindings::IORESOURCE_MEM as usize;
+    // SAFETY: `Resource` is a transparent wrapper around `Opaque<bindings::resource>`, and `raw`
+    // describes a valid memory range (as `Uat::map_physical` builds it).
+    Ok(unsafe { core::mem::transmute(kernel::types::Opaque::new(raw)) })
+}
