+++ b/drivers/gpu/drm/asahi/g17/fw/initdata/v27_2.rs
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! The data blocks of the macOS 27.2 firmware of the M4 Pro (j614s patch).
+//!
+//! 27.2 keeps the 25G83 hardware data and power configuration, moved in runs and with a few
+//! other constants (nixos-m4pro docs/gpu/driver-27.2-diff.md §7, §9, §10). The driver builds
+//! the 25G83 blocks as before and [`hw_data`] and [`power_config`] move them to their 27.2
+//! offsets; each run and value was checked word by word against macOS 27.2's blocks at its
+//! InitData message. What macOS writes that is not here: the words at +0xe0..+0x5ec of the
+//! hardware data (left zero, as the 25G83 driver does) and the fractions of the table A
+//! relative performance (the device tree has whole percents).
+
+use crate::float::F32;
+use kernel::prelude::*;
+
+/// Size of the 25G83 hardware data ([`super::v25g83::HwData25G83`]).
+pub(crate) const HW_DATA_25G83: usize = 0x3db4;
+/// Size of the 27.2 hardware data; the bundle's first view follows it under macOS.
+pub(crate) const HW_DATA: usize = 0x2880;
+/// Size of the 25G83 power configuration ([`super::v25g83::PowerConfig25G83`]).
+pub(crate) const POWER_CONFIG_25G83: usize = 0x6510;
+
+/// A run of `len` bytes at 25G83 offset `from`, at 27.2 offset `to`.
+struct Run {
+    from: usize,
+    to: usize,
+    len: usize,
+}
+
+const fn run(from: usize, end: usize, to: usize) -> Run {
+    Run {
+        from,
+        to,
+        len: end - from,
+    }
+}
+
+const REGISTER_MAP: usize = 0x640;
+const REGISTER_MAP_ENTRY: usize = 0x28;
+/// Register-map slots: 53 in 25G83, 60 in 27.2. Slots from 23 on moved up by 5.
+const SLOTS_25G83: usize = 53;
+const SLOTS: usize = 60;
+const fn slot_27_2(slot: usize) -> usize {
+    if slot < 23 {
+        slot
+    } else {
+        slot + 5
+    }
+}
+/// Empty slots macOS marks with flags 2.
+const RESERVED_SLOTS: [usize; 17] = [
+    2, 5, 6, 7, 8, 25, 26, 27, 32, 35, 43, 47, 52, 53, 54, 55, 58,
+];
+/// The slot of the GPU SRAM window (phys 0x2_88d6_0000; 25G83 slot 32).
+const SRAM_SLOT: usize = 37;
+
+const HW_DATA_RUNS: [Run; 5] = [
+    run(0, REGISTER_MAP, 0),
+    // chip_id .. unk_eb8; 25G83's unk_ebc is gone.
+    run(0xe90, 0xebc, 0xfb0),
+    // unk_ec0 .. unk_25fc: the performance tables and the core counts.
+    run(0xec0, 0x2600, 0xfdc),
+    // unk_2614 .. qos_va: the completion rings.
+    run(0x2614, 0x26c0, 0x2734),
+    // From unk_26c0: after the new pointer at +0x27e0.
+    run(0x26c0, 0x2758, 0x27e8),
+];
+
+/// Words macOS 27.2 writes differently, at 27.2 offsets.
+const HW_DATA_WORDS: [(usize, u32); 8] = [
+    (0x1044, 0xc),
+    (0x1088, 1),
+    // Core slots (2 x 10), not enabled cores.
+    (0x10a4, 20),
+    (0x10d4, 0x13),
+    (0x10dc, 20),
+    (0x26b0, 0x1e_0000),
+    // sched_pause_timeout_us.
+    (0x271c, 150),
+    // trace_enable.
+    (0x2730, 1),
+];
+const HW_DATA_BYTES: [(usize, u8); 2] = [(0x2846, 1), (0x284a, 1)];
+
+/// Table A in 27.2: core voltages per lane at +0x44, SRAM voltages at +0x444.
+const PERF_A: usize = 0x10e0;
+const PERF_A_FREQ: usize = PERF_A + 4;
+const PERF_A_CORE_MV: usize = PERF_A + 0x44;
+const PERF_A_SRAM_MV: usize = PERF_A + 0x444;
+const PERF_STATES: usize = 11;
+const PERF_LANES: usize = 16;
+/// Relative performance of tables A and B, f32 in 27.2 (u32 percents in 25G83).
+const RELATIVE_A: usize = 0x19e4;
+const RELATIVE_B: usize = 0x1a24;
+const RELATIVE_A_25G83: usize = 0x18c8;
+const RELATIVE_B_25G83: usize = 0x1908;
+/// The CS performance table, which macOS leaves zero.
+const CS_PERF: usize = 0x1b64;
+const AUX_PERF_TABLE: usize = 0x148;
+const SRAM_POINTER: usize = 0xfa0;
+const SRAM_SIZE: u64 = 0x8000;
+/// A page macOS names at +0x27e0, 0x8000 below the QoS object; zero at boot.
+const EXTRA_POINTER: usize = 0x27e0;
+
+fn get(bytes: &[u8], at: usize) -> Result<u32> {
+    let word = bytes.get(at..at + 4).ok_or(EINVAL)?;
+    Ok(u32::from_le_bytes(word.try_into().map_err(|_| EINVAL)?))
+}
+
+fn put(bytes: &mut [u8], at: usize, value: &[u8]) -> Result {
+    bytes
+        .get_mut(at..at + value.len())
+        .ok_or(EINVAL)?
+        .copy_from_slice(value);
+    Ok(())
+}
+
+/// Moves `runs` of `block` (as built for 25G83, `block.len()` bytes) to their 27.2 offsets,
+/// zeroing everything else, and returns the 25G83 copy.
+fn relayout(block: &mut [u8], runs: &[Run]) -> Result<KVVec<u8>> {
+    let mut old = KVVec::from_elem(0u8, block.len(), GFP_KERNEL)?;
+    old.copy_from_slice(block);
+    block.fill(0);
+    for r in runs {
+        let from = old.get(r.from..r.from + r.len).ok_or(EINVAL)?;
+        put(block, r.to, from)?;
+    }
+    Ok(old)
+}
+
+/// Moves the 25G83 hardware data in `block` to the 27.2 layout. `lanes` is the number of
+/// voltage lanes the 25G83 table A filled (one per cluster); `extra_va` is a zeroed page.
+pub(crate) fn hw_data(block: &mut [u8], lanes: usize, extra_va: u64) -> Result {
+    if block.len() != HW_DATA_25G83 || !(1..=PERF_LANES).contains(&lanes) {
+        return Err(EINVAL);
+    }
+    let old = relayout(block, &HW_DATA_RUNS)?;
+    let entry = |slot: usize| REGISTER_MAP + slot * REGISTER_MAP_ENTRY;
+    for slot in 0..SLOTS_25G83 {
+        let from = old.get(entry(slot)..entry(slot + 1)).ok_or(EINVAL)?;
+        put(block, entry(slot_27_2(slot)), from)?;
+    }
+    for slot in RESERVED_SLOTS {
+        if slot >= SLOTS || block[entry(slot)..entry(slot + 1)].iter().any(|&b| b != 0) {
+            return Err(EINVAL);
+        }
+        put(block, entry(slot) + 0x20, &2u32.to_le_bytes())?;
+    }
+    // The SRAM pointer names the SRAM window the register map already maps.
+    let sram = entry(SRAM_SLOT);
+    let sram_va = u64::from(get(block, sram + 8)?) | (u64::from(get(block, sram + 12)?) << 32);
+    if get(block, sram)? != 0x88d6_0000 || sram_va == 0 {
+        return Err(EINVAL);
+    }
+    put(block, SRAM_POINTER, &sram_va.to_le_bytes())?;
+    put(block, SRAM_POINTER + 8, &SRAM_SIZE.to_le_bytes())?;
+    put(block, EXTRA_POINTER, &extra_va.to_le_bytes())?;
+    for (at, value) in HW_DATA_WORDS {
+        put(block, at, &value.to_le_bytes())?;
+    }
+    for (at, value) in HW_DATA_BYTES {
+        put(block, at, &[value])?;
+    }
+    block[CS_PERF..CS_PERF + AUX_PERF_TABLE].fill(0);
+
+    // Every lane of table A carries the first lane's voltages.
+    for state in 0..PERF_STATES {
+        for base in [PERF_A_CORE_MV, PERF_A_SRAM_MV] {
+            let row = base + state * PERF_LANES * 4;
+            let first = get(block, row)?;
+            for lane in lanes..PERF_LANES {
+                put(block, row + lane * 4, &first.to_le_bytes())?;
+            }
+        }
+    }
+
+    // Relative performance as f32: table A from its whole percents; table B exactly, as the
+    // share of table A's frequency range above its first state.
+    let hundred = F32::from(100u32);
+    let relative_b: [u32; PERF_STATES] = core::array::from_fn(|i| {
+        old.get(RELATIVE_B_25G83 + 4 * i..RELATIVE_B_25G83 + 4 * i + 4)
+            .map_or(0, |w| u32::from_le_bytes([w[0], w[1], w[2], w[3]]))
+    });
+    let base = relative_b.iter().take_while(|&&v| v == 0).count().saturating_sub(1);
+    let mut freq = [0u32; PERF_STATES];
+    for (i, f) in freq.iter_mut().enumerate() {
+        *f = get(block, PERF_A_FREQ + 4 * i)?;
+    }
+    let (low, top) = (freq[base], freq[PERF_STATES - 1]);
+    if top <= low {
+        return Err(EINVAL);
+    }
+    for i in 0..PERF_STATES {
+        let a = F32::from(get(&old, RELATIVE_A_25G83 + 4 * i)?);
+        put(block, RELATIVE_A + 4 * i, &a.to_bits().to_le_bytes())?;
+        let b = match i > base {
+            true => {
+                hundred * F32::from(freq[i].saturating_sub(low)) / F32::from(top - low)
+            }
+            false => F32::from(0u32),
+        };
+        put(block, RELATIVE_B + 4 * i, &b.to_bits().to_le_bytes())?;
+    }
+    Ok(())
+}
+
+const POWER_CONFIG_RUNS: [Run; 6] = [
+    run(0, 0xc0, 0),
+    run(0xc0, 0x2874, 0xd0),
+    run(0x2874, 0x2c48, 0x289c),
+    // 8 bytes fewer between 0x2c48 and 0x2e2c.
+    run(0x2c50, 0x3b50, 0x2c70),
+    // The config status pointer (0x3b50) and what follows.
+    run(0x3b50, 0x5b70, 0x3b98),
+    // The AON table pointer and its sensor names. The entropy and leakage words after them
+    // (0x63d4, 0x6420, 0x642c..) have no place in 27.2: macOS leaves that range zero.
+    run(0x6318, 0x6378, 0x6340),
+];
+
+/// Words macOS 27.2 writes differently, at 27.2 offsets.
+const POWER_CONFIG_WORDS: [(usize, u32); 10] = [
+    (0x9c, 1),
+    (0xa0, 1),
+    (0xa4, 1),
+    (0xa8, 1),
+    // -0.0176 (25G83: -0.0145).
+    (0x9fc, 0xbc90_4e81),
+    // 40 (25G83: 100).
+    (0xa00, 40),
+    (0xab8, 40),
+    (0x22c0, 40),
+    (0x2c68, 40),
+    // 100.0 (25G83: the integer 100).
+    (0x2f0c, 0x42c8_0000),
+];
+
+/// Moves the 25G83 power configuration in `block` to the 27.2 layout.
+pub(crate) fn power_config(block: &mut [u8]) -> Result {
+    if block.len() != POWER_CONFIG_25G83 {
+        return Err(EINVAL);
+    }
+    relayout(block, &POWER_CONFIG_RUNS)?;
+    for (at, value) in POWER_CONFIG_WORDS {
+        put(block, at, &value.to_le_bytes())?;
+    }
+    Ok(())
+}
+
+/// Nonzero words of the 27.2 power state (our PowerMgmt27) at macOS 27.2's InitData message,
+/// besides the maximum power at [`POWER_STATE_MAX_POWER`]. +0xc8/+0xcc are the fast-die
+/// target and release temperatures (110.00 and 80.00 °C).
+pub(crate) const POWER_STATE_WORDS: [(usize, u32); 22] = [
+    (0x10, 0x1f),
+    (0x14, 0x3d25_bea1),
+    (0x18, 0x3f4f_2e49),
+    (0x1c, 0x28),
+    (0x20, 1),
+    (0xc8, 11_000),
+    (0xcc, 8_000),
+    (0xd8, 0x4214_0000),
+    (0xdc, 0x414e_eeee),
+    (0xf0, 0x26ac),
+    (0xf4, 0xc8),
+    (0x108, 0x42c8_0000),
+    (0x10c, 0x43c8_0000),
+    (0x110, 0xc8),
+    (0x128, 1),
+    (0x130, 0x3ecf_2e49),
+    (0x134, 0x3e3b_d7b3),
+    (0x624, 0x4170_0000),
+    (0x628, 0x40a0_0000),
+    (0x62c, 0x20),
+    (0x630, 0x3e8),
+    (0x640, 0x384),
+];
+/// Where the 27.2 power state holds the maximum power in mW.
+pub(crate) const POWER_STATE_MAX_POWER: usize = 0x12c;
